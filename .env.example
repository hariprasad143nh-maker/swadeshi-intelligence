# Swadeshi Intelligence Environment Configuration

# Application
APP_ENV=development
APP_NAME="Swadeshi Intelligence"
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swadeshi_db
# For SQLite local fallback if PostgreSQL is not locally installed:
# DATABASE_URL=sqlite:///./swadeshi.db

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security (for future admin/auth modules)
SECRET_KEY=change-this-in-production-to-a-secure-random-key
